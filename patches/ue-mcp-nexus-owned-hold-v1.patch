+// Every value is provisional until the entire bridge transport has a matching
+// receive bound. A rejected or resized frame is never claimed as full output.
+namespace
+{
+constexpr int32 NexusMaxAxis = 4096;
+constexpr int64 NexusMaxPixels = 4 * 1024 * 1024;
+constexpr int64 NexusMaxPngBytes = 8 * 1024 * 1024;
+bool GNexusCaptureActive = false;
+
+bool NexusCaptureGeometry(const TSharedRef<SWidget>& Widget, FVector2f& Position, FVector2f& Size)
+{
+	FWidgetPath Path;
+	if (!FSlateApplication::Get().GeneratePathToWidgetUnchecked(Widget, Path))
+	{
+		return false;
+	}
+	const FArrangedWidget Arranged = Path.FindArrangedWidget(Widget).Get(FArrangedWidget::GetNullWidget());
+	Position = FVector2f(Arranged.Geometry.AbsolutePosition);
+	Size = FVector2f(Arranged.Geometry.GetDrawSize());
+	return FMath::IsFinite(Position.X) && FMath::IsFinite(Position.Y)
+		&& FMath::IsFinite(Size.X) && FMath::IsFinite(Size.Y);
+}
+}
