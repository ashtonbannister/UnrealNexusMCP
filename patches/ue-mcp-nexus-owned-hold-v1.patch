+// Nexus holds inject one frame at a time and never claim or remove Unreal's
+// shared continuous-injection slot. Their private ID and owner token are
+// coordinator-generated. A finite wall-time lease bounds abandoned holds.
+namespace NexusInputHolds
+{
+	struct FHold
+	{
+		FString OwnerToken;
+		FString WorldPath;
+		int32 PIEInstance = INDEX_NONE;
+		int32 LocalPlayerIndex = INDEX_NONE;
+		TWeakObjectPtr<UWorld> World;
+		TWeakObjectPtr<ULocalPlayer> Player;
+		TWeakObjectPtr<UInputAction> Action;
+		FInputActionValue Value;
+		double ExpiresAt = 0;
+		uint64 Frames = 0;
+		bool bActive = true;
+	};
+
+	static TMap<FString, FHold> Holds;
+	static FDelegateHandle TickHandle;
+
+	static bool IsHexToken(const FString& Value)
+	{
+		if (Value.Len() != 32) return false;
+		for (TCHAR C : Value)
+			if (!((C >= TEXT('0') && C <= TEXT('9')) || (C >= TEXT('a') && C <= TEXT('f')))) return false;
+		return true;
+	}
+
+	static bool ReadIdAndToken(const TSharedPtr<FJsonObject>& Params, FString& Id, FString& Token)
+	{
+		return TryGetStringParam(Params, TEXT("native_id"), Id)
+			&& TryGetStringParam(Params, TEXT("owner_token"), Token)
+			&& IsHexToken(Id) && IsHexToken(Token);
+	}
+
+	static bool ReadValues(const TSharedPtr<FJsonObject>& Params, double& X, double& Y, double& Z)
+	{
+		auto Read = [&Params](const TCHAR* Key, double Default, double& Out)
+		{
+			if (!HasParam(Params, Key)) { Out = Default; return true; }
+			return TryGetNumberParam(Params, Key, Out) && FMath::IsFinite(Out)
+				&& FMath::Abs(Out) <= static_cast<double>(MAX_flt);
+		};
+		return Read(TEXT("value_x"), 1.0, X) && Read(TEXT("value_y"), 0.0, Y)
+			&& Read(TEXT("value_z"), 0.0, Z);
+	}
+
+	static FInputActionValue NexusMakeInputValue(const UInputAction* Action, double X, double Y, double Z)
+	{
+		switch (Action->ValueType)
+		{
+		case EInputActionValueType::Boolean: return FInputActionValue(X != 0.0);
+		case EInputActionValueType::Axis1D: return FInputActionValue(static_cast<float>(X));
+		case EInputActionValueType::Axis2D: return FInputActionValue(FVector2D(X, Y));
+		case EInputActionValueType::Axis3D: return FInputActionValue(FVector(X, Y, Z));
+		}
+		return FInputActionValue();
+	}
+
+	static bool StillTargetsSamePlayer(const FHold& Hold)
+	{
+		UWorld* World = Hold.World.Get();
+		ULocalPlayer* Player = Hold.Player.Get();
+		if (!GEngine || !World || !Player || !Hold.Action.IsValid()) return false;
+		int32 Matches = 0;
+		for (const FWorldContext& Context : GEngine->GetWorldContexts())
+		{
+			if (Context.WorldType == EWorldType::PIE && Context.PIEInstance == Hold.PIEInstance
+				&& Context.World() && Context.World()->GetPathName() == Hold.WorldPath)
+			{
+				if (Context.World() != World) return false;
+				++Matches;
+			}
+		}
+		if (Matches != 1) return false;
+		MCPPIE::PIEWorldResolver::FPlayerTarget Target;
+		FString Error;
+		if (!MCPPIE::PIEWorldResolver::ResolvePlayerInWorld(World, Hold.LocalPlayerIndex, Target, Error)
+			|| Target.LocalPlayer != Player) return false;
+		const UEnhancedInputLocalPlayerSubsystem* Subsystem = Player->GetSubsystem<UEnhancedInputLocalPlayerSubsystem>();
+		return Subsystem && Subsystem->GetPlayerInput();
+	}
+
+	static void Tick()
+	{
+		const double Now = FPlatformTime::Seconds();
+		bool bAnyActive = false;
+		for (auto It = Holds.CreateIterator(); It; ++It)
+		{
+			FHold& Hold = It.Value();
+			if (!Hold.bActive) continue;
+			if (Now >= Hold.ExpiresAt || !StillTargetsSamePlayer(Hold))
+			{
+				Hold.bActive = false;
+				continue;
+			}
+			FString Error;
+			if (!MCPPIE::FPIEInputInjector::InjectOnce(Hold.Action.Get(), Hold.Value, Error,
+				Hold.LocalPlayerIndex, Hold.PIEInstance, Hold.Player.Get()))
+			{
+				Hold.bActive = false;
+				continue;
+			}
+			++Hold.Frames;
+			bAnyActive = true;
+		}
+		if (!bAnyActive && TickHandle.IsValid())
+		{
+			FCoreDelegates::OnEndFrame.Remove(TickHandle);
+			TickHandle.Reset();
+		}
+	}
+
+	void Reset()
+	{
+		Holds.Reset();
+		if (TickHandle.IsValid())
+		{
+			FCoreDelegates::OnEndFrame.Remove(TickHandle);
+			TickHandle.Reset();
+		}
+	}
+
+	TSharedPtr<FJsonValue> Start(const TSharedPtr<FJsonObject>& Params)
+	{
+		MCP_CHECK_GAME_THREAD();
+		FString Id, Token, Path, WorldPath;
+		double InstanceValue = -1, PlayerValue = -1, Lease = 0, X, Y, Z;
+		if (!ReadIdAndToken(Params, Id, Token)
+			|| !TryGetStringParam(Params, TEXT("action_path"), Path) || Path.IsEmpty()
+			|| !TryGetStringParam(Params, TEXT("world_path"), WorldPath) || WorldPath.IsEmpty()
+			|| !TryGetNumberParam(Params, TEXT("pie_instance"), InstanceValue)
+			|| !FMath::IsFinite(InstanceValue) || InstanceValue < 0 || InstanceValue > MAX_int32
+			|| FMath::FloorToDouble(InstanceValue) != InstanceValue
+			|| !TryGetNumberParam(Params, TEXT("client_id"), PlayerValue)
+			|| !FMath::IsFinite(PlayerValue) || PlayerValue < 0 || PlayerValue > 255
+			|| FMath::FloorToDouble(PlayerValue) != PlayerValue
+			|| !TryGetNumberParam(Params, TEXT("lease_seconds"), Lease)
+			|| !FMath::IsFinite(Lease) || Lease < 1 || Lease > 3600
+			|| !ReadValues(Params, X, Y, Z))
+			return MCPError(TEXT("Invalid owned input hold parameters"));
+		if (!GEngine || Holds.Num() >= 64 || Holds.Contains(Id))
+			return MCPError(TEXT("Owned input hold capacity or ID conflict"));
+		const int32 Instance = static_cast<int32>(InstanceValue);
+		UWorld* World = nullptr;
+		int32 Matches = 0;
+		for (const FWorldContext& Context : GEngine->GetWorldContexts())
+		{
+			if (Context.WorldType == EWorldType::PIE && Context.PIEInstance == Instance
+				&& Context.World() && Context.World()->GetPathName() == WorldPath)
+			{
+				World = Context.World();
+				++Matches;
+			}
+		}
+		if (Matches != 1) return MCPError(TEXT("Expected exactly one matching PIE world"));
+		MCPPIE::PIEWorldResolver::FPlayerTarget Target;
+		FString Error;
+		if (!MCPPIE::PIEWorldResolver::ResolvePlayerInWorld(World, static_cast<int32>(PlayerValue), Target, Error))
+			return MCPError(Error);
+		const UEnhancedInputLocalPlayerSubsystem* Subsystem = Target.LocalPlayer->GetSubsystem<UEnhancedInputLocalPlayerSubsystem>();
+		if (!Subsystem || !Subsystem->GetPlayerInput()) return MCPError(TEXT("Enhanced Input player input is unavailable"));
+		TSharedPtr<FJsonValue> LoadError;
+		UInputAction* Action = LoadInputAction(Path, LoadError);
+		if (!Action) return LoadError;
+		if (Action->GetPathName() != Path) return MCPError(TEXT("InputAction path must be the exact object path"));
+		for (const TPair<FString,FHold>& Pair : Holds)
+			if (Pair.Value.bActive && FPlatformTime::Seconds() < Pair.Value.ExpiresAt
+				&& Pair.Value.Player.Get() == Target.LocalPlayer && Pair.Value.Action.Get() == Action)
+				return MCPError(TEXT("This player and action already have a Nexus-owned hold"));
+		FHold Hold;
+		Hold.OwnerToken = Token;
+		Hold.WorldPath = WorldPath;
+		Hold.PIEInstance = Instance;
+		Hold.LocalPlayerIndex = static_cast<int32>(PlayerValue);
+		Hold.World = World;
+		Hold.Player = Target.LocalPlayer;
+		Hold.Action = Action;
+		Hold.Value = NexusMakeInputValue(Action, X, Y, Z);
+		Hold.ExpiresAt = FPlatformTime::Seconds() + Lease;
+		Holds.Add(Id, MoveTemp(Hold));
+		if (!TickHandle.IsValid()) TickHandle = FCoreDelegates::OnEndFrame.AddStatic(&Tick);
+		auto Result = MCPSuccess();
+		Result->SetNumberField(TEXT("nexusHoldVersion"), 1);
+		Result->SetStringField(TEXT("native_id"), Id);
+		Result->SetStringField(TEXT("action"), Action->GetPathName());
+		Result->SetStringField(TEXT("world_path"), WorldPath);
+		Result->SetNumberField(TEXT("pie_instance"), Instance);
+		Result->SetNumberField(TEXT("client_id"), PlayerValue);
+		Result->SetNumberField(TEXT("lease_seconds"), Lease);
+		Result->SetBoolField(TEXT("started"), true);
+		Result->SetBoolField(TEXT("continuousSlotTouched"), false);
+		Result->SetBoolField(TEXT("firstFramePending"), true);
+		return MCPResult(Result);
+	}
+
+	TSharedPtr<FJsonValue> Update(const TSharedPtr<FJsonObject>& Params)
+	{
+		MCP_CHECK_GAME_THREAD();
+		FString Id, Token;
+		double X, Y, Z;
+		if (!ReadIdAndToken(Params, Id, Token) || !ReadValues(Params, X, Y, Z))
+			return MCPError(TEXT("Invalid owned input hold update"));
+		FHold* Hold = Holds.Find(Id);
+		if (!Hold || Hold->OwnerToken != Token)
+			return MCPError(TEXT("Owned input hold absent or mismatched"));
+		if (!Hold->bActive || FPlatformTime::Seconds() >= Hold->ExpiresAt || !StillTargetsSamePlayer(*Hold))
+		{
+			Hold->bActive = false;
+			auto Result = MakeShared<FJsonObject>();
+			Result->SetBoolField(TEXT("success"), false);
+			Result->SetNumberField(TEXT("nexusHoldVersion"), 1);
+			Result->SetStringField(TEXT("native_id"), Id);
+			Result->SetStringField(TEXT("reason"), TEXT("expired_or_ended"));
+			Result->SetBoolField(TEXT("mutationStarted"), false);
+			Result->SetStringField(TEXT("error"), TEXT("Owned input hold has expired or its PIE target ended"));
+			return MCPResult(Result);
+		}
+		Hold->Value = NexusMakeInputValue(Hold->Action.Get(), X, Y, Z);
+		auto Result = MCPSuccess();
+		Result->SetNumberField(TEXT("nexusHoldVersion"), 1);
+		Result->SetStringField(TEXT("native_id"), Id);
+		Result->SetBoolField(TEXT("updated"), true);
+		Result->SetNumberField(TEXT("framesQueued"), static_cast<double>(Hold->Frames));
+		Result->SetBoolField(TEXT("continuousSlotTouched"), false);
+		return MCPResult(Result);
+	}
+
+	TSharedPtr<FJsonValue> Stop(const TSharedPtr<FJsonObject>& Params)
+	{
+		MCP_CHECK_GAME_THREAD();
+		FString Id, Token;
+		if (!ReadIdAndToken(Params, Id, Token)) return MCPError(TEXT("Invalid owned input hold stop"));
+		FHold* Hold = Holds.Find(Id);
+		if (!Hold || Hold->OwnerToken != Token) return MCPError(TEXT("Owned input hold absent or mismatched"));
+		const uint64 Frames = Hold->Frames;
+		const bool bExpiredOrEnded = !Hold->bActive || FPlatformTime::Seconds() >= Hold->ExpiresAt || !StillTargetsSamePlayer(*Hold);
+		Holds.Remove(Id);
+		if (Holds.IsEmpty() && TickHandle.IsValid())
+		{
+			FCoreDelegates::OnEndFrame.Remove(TickHandle);
+			TickHandle.Reset();
+		}
+		auto Result = MCPSuccess();
+		Result->SetNumberField(TEXT("nexusHoldVersion"), 1);
+		Result->SetStringField(TEXT("native_id"), Id);
+		Result->SetBoolField(TEXT("stopped"), true);
+		Result->SetBoolField(TEXT("expiredOrEnded"), bExpiredOrEnded);
+		Result->SetNumberField(TEXT("framesQueued"), static_cast<double>(Frames));
+		Result->SetBoolField(TEXT("continuousSlotTouched"), false);
+		Result->SetBoolField(TEXT("oneFrameMayRemain"), true);
+		return MCPResult(Result);
+	}
+}
