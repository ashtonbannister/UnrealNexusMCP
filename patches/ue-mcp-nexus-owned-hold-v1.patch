+// Fixed screenshot-only transport. Never used for general bridge methods.
+// Experimental until the Nexus compatibility manifest and coordinator land.
+
+const METHOD = "nexus_capture_pie_png_v1";
+const MAX_FRAME = 12 * 1024 * 1024;
+const MAX_PNG = 8 * 1024 * 1024;
+
+function invalid(message: string): McpError {
+  return new McpError(ErrorCode.CONNECTION_LOST, message, {outcome:"unknown",method:METHOD});
+}
+function record(x: unknown): x is Record<string, unknown> {
+  return x !== null && typeof x === "object" && !Array.isArray(x);
+}
+
+// Reject duplicate keys at every object depth before JSON.parse. The frame is
+// already bounded by ws. This scans rather than materializing the large string
+// payload a second time; JSON.parse remains the final syntax validator.
+function rejectDuplicateKeys(text: string): void {
+  let i=0;
+  const white=()=>{while(i<text.length && /[\x20\t\r\n]/.test(text[i]!)) i++;};
+  const string=(decode=true): string=>{
+    if(text[i++]!=='"') throw invalid("Malformed capture JSON");
+    const start=i-1;
+    while(i<text.length) {
+      const c=text[i++]!;
+      if(c==='"') {
+        try { return decode ? JSON.parse(text.slice(start,i)) as string : ""; }
+        catch { throw invalid("Malformed capture JSON string"); }
+      }
+      if(c==='\\') { if(i>=text.length) throw invalid("Malformed capture JSON escape"); i++; }
+      else if(c.charCodeAt(0)<32) throw invalid("Malformed capture JSON string");
+    }
+    throw invalid("Unterminated capture JSON string");
+  };
+  const value=(depth: number): void=>{
+    if(depth>16) throw invalid("Capture JSON nesting exceeds limit");
+    white();
+    const c=text[i];
+    if(c==='"') { string(false); return; }
+    if(c==='{' || c==='[') {
+      const object=c==='{', close=object?'}':']'; i++; white();
+      const seen=new Set<string>();
+      if(text[i]===close) {i++;return;}
+      while(i<text.length) {
+        if(object) {
+          white();const key=string();
+          if(seen.has(key)) throw invalid("Duplicate capture JSON key");
+          seen.add(key);white();if(text[i++]!==':') throw invalid("Malformed capture JSON object");
+        }
+        value(depth+1);white();
+        if(text[i]===close) {i++;return;}
+        if(text[i++]!==',') throw invalid("Malformed capture JSON container");
+      }
+      throw invalid("Unterminated capture JSON container");
+    }
+    const m=/^(?:true|false|null|-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)/.exec(text.slice(i,i+64));
