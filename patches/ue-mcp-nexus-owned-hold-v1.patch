+TSharedPtr<FJsonValue> FEditorHandlers::NexusCapturePIEPng(const TSharedPtr<FJsonObject>& Params)
+{
+	double RawInstance = -1;
+	FString WorldPath, Nonce;
+	if (!TryGetNumberParam(Params, TEXT("pieInstance"), RawInstance)
+		|| !FMath::IsFinite(RawInstance) || RawInstance < 0 || RawInstance > MAX_int32
+		|| FMath::FloorToDouble(RawInstance) != RawInstance
+		|| !TryGetStringParam(Params, TEXT("worldPath"), WorldPath) || WorldPath.IsEmpty()
+		|| !TryGetStringParam(Params, TEXT("nonce"), Nonce) || Nonce.Len() != 32)
+	{
+		return MCPError(TEXT("Invalid exact PIE target or nonce"));
+	}
+	for (TCHAR Ch : Nonce)
+	{
+		if (!((Ch >= TEXT('0') && Ch <= TEXT('9')) || (Ch >= TEXT('a') && Ch <= TEXT('f'))))
+		{
+			return MCPError(TEXT("Nonce must be lowercase hexadecimal"));
+		}
+	}
+	if (!GEngine || !FSlateApplication::IsInitialized() || GNexusCaptureActive)
+	{
+		return MCPError(TEXT("Capture unavailable or already active"));
+	}
+	TGuardValue<bool> ActiveGuard(GNexusCaptureActive, true);
+	const int32 Instance = static_cast<int32>(RawInstance);
+	UWorld* SelectedWorld = nullptr;
+	int32 Matches = 0;
+	for (const FWorldContext& Context : GEngine->GetWorldContexts())
+	{
+		UWorld* World = Context.World();
+		if (Context.WorldType == EWorldType::PIE && World && Context.PIEInstance == Instance
+			&& World->GetPathName() == WorldPath)
+		{
+			SelectedWorld = World;
+			++Matches;
+		}
+	}
+	if (Matches != 1)
+	{
+		return MCPError(TEXT("Expected exactly one matching PIE world"));
+	}
+	TWeakObjectPtr<UWorld> WeakWorld(SelectedWorld);
+	UGameViewportClient* Viewport = SelectedWorld->GetGameViewport();
+	if (!Viewport || !Viewport->Viewport || !Viewport->GetGameViewportWidget().IsValid())
+	{
+		return MCPError(TEXT("The selected PIE world has no capturable viewport"));
+	}
+	const TSharedRef<SWidget> Widget = Viewport->GetGameViewportWidget().ToSharedRef();
+	FSlateRenderer* Renderer = FSlateApplication::Get().GetRenderer();
+	const TSharedPtr<SWindow> Window = FSlateApplication::Get().FindWidgetWindow(Widget);
+	FVector2f Position, Size;
+	if (!Renderer || !Window.IsValid() || !NexusCaptureGeometry(Widget, Position, Size))
+	{
+		return MCPError(TEXT("The selected PIE viewport has no drawable Slate window"));
+	}
+	const FVector2f WindowPosition = Window->GetPositionInScreen();
+	const FVector2f WindowSize = Window->GetSizeInScreen();
+	const bool bOffScreen = FParse::Param(FCommandLine::Get(), TEXT("RenderOffScreen"));
+	const FString NotDrawn = MCPWhySlateWindowNotDrawn(*Window,
+		bOffScreen || Renderer->GetViewportResource(*Window) != nullptr, Size);
+	if (!NotDrawn.IsEmpty())
+	{
+		return MCPError(FString::Printf(TEXT("PIE viewport is not drawn: %s"), *NotDrawn));
+	}
+	if (Position.X < WindowPosition.X || Position.Y < WindowPosition.Y
+		|| Size.X < 1 || Size.Y < 1 || Size.X > NexusMaxAxis || Size.Y > NexusMaxAxis
+		|| Position.X + Size.X > WindowPosition.X + WindowSize.X
+		|| Position.Y + Size.Y > WindowPosition.Y + WindowSize.Y)
+	{
+		return MCPError(FString::Printf(TEXT("PIE viewport is clipped or exceeds capture bounds: position=(%.1f,%.1f) size=(%.1f,%.1f), window=(%.1f,%.1f) size=(%.1f,%.1f)"),
+			Position.X, Position.Y, Size.X, Size.Y, WindowPosition.X, WindowPosition.Y, WindowSize.X, WindowSize.Y));
+	}
+	const int32 Width = static_cast<int32>(Size.X);
+	const int32 Height = static_cast<int32>(Size.Y);
+	if (Width < 1 || Height < 1 || static_cast<int64>(Width) * Height > NexusMaxPixels)
+	{
+		return MCPError(TEXT("PIE viewport exceeds capture pixel limit"));
+	}
+	TArray<FColor>& Sink = MCPSlateCaptureSink();
+	if (MCPSlateCaptureMayBePending())
+	{
+		FlushRenderingCommands();
+		MCPSlateCaptureMayBePending() = false;
+	}
+	Sink.Reset();
+	FIntVector CaptureSize = FIntVector::ZeroValue;
+	const bool bCaptured = FSlateApplication::Get().TakeScreenshot(
+		Widget, FIntRect(0, 0, Width, Height), Sink, CaptureSize);
+	if (!bCaptured || CaptureSize.X != Width || CaptureSize.Y != Height
+		|| Sink.Num() != static_cast<int64>(Width) * Height)
+	{
+		Renderer->PrepareToTakeScreenshot(FIntRect(0, 0, 1, 1), &Sink, Window.Get());
+		MCPSlateCaptureMayBePending() = true;
+		return MCPError(TEXT("The bounded PIE viewport readback was incomplete"));
+	}
+	FVector2f PositionAfter, SizeAfter;
+	int32 MatchesAfter = 0;
+	bool bSameWorldAfter = false;
+	if (WeakWorld.IsValid())
+	{
+		for (const FWorldContext& Context : GEngine->GetWorldContexts())
+		{
+			UWorld* Candidate = Context.World();
+			if (Context.WorldType == EWorldType::PIE && Context.PIEInstance == Instance
+				&& Candidate && Candidate->GetPathName() == WorldPath)
+			{
+				++MatchesAfter;
+				bSameWorldAfter = Candidate == WeakWorld.Get();
+			}
+		}
+	}
+	UGameViewportClient* ViewportAfter = WeakWorld.IsValid() ? WeakWorld->GetGameViewport() : nullptr;
+	if (MatchesAfter != 1 || !bSameWorldAfter || !ViewportAfter || ViewportAfter != Viewport || !ViewportAfter->GetGameViewportWidget().IsValid()
+		|| ViewportAfter->GetGameViewportWidget().Get() != &Widget.Get()
+		|| !NexusCaptureGeometry(Widget, PositionAfter, SizeAfter)
+		|| PositionAfter != Position || SizeAfter != Size
+		|| FSlateApplication::Get().FindWidgetWindow(Widget) != Window)
+	{
+		Sink.Reset();
+		return MCPError(TEXT("PIE viewport changed during capture; frame discarded"));
+	}
+	for (FColor& Pixel : Sink) Pixel.A = 255;
+	IImageWrapperModule& Module = FModuleManager::LoadModuleChecked<IImageWrapperModule>(TEXT("ImageWrapper"));
+	const TSharedPtr<IImageWrapper> Encoder = Module.CreateImageWrapper(EImageFormat::PNG);
+	if (!Encoder.IsValid() || !Encoder->SetRaw(Sink.GetData(), static_cast<int64>(Sink.Num()) * sizeof(FColor),
+		Width, Height, ERGBFormat::BGRA, 8))
+	{
+		Sink.Reset();
+		return MCPError(TEXT("PIE PNG encoding failed"));
+	}
+	const TArray64<uint8>& Png = Encoder->GetCompressed(100);
+	if (Png.IsEmpty() || Png.Num() > NexusMaxPngBytes)
+	{
+		Sink.Reset();
+		return MCPError(TEXT("PIE PNG exceeds encoded byte limit"));
+	}
+	const FString Encoded = FBase64::Encode(Png.GetData(), static_cast<uint32>(Png.Num()));
+	Sink.Reset();
+	auto Result = MCPSuccess();
+	Result->SetNumberField(TEXT("nexusCaptureVersion"), 1);
+	Result->SetStringField(TEXT("nonce"), Nonce);
+	Result->SetNumberField(TEXT("pieInstance"), Instance);
+	Result->SetStringField(TEXT("worldPath"), WorldPath);
+	Result->SetNumberField(TEXT("width"), Width);
+	Result->SetNumberField(TEXT("height"), Height);
+	Result->SetNumberField(TEXT("pngBytes"), Png.Num());
+	Result->SetStringField(TEXT("pngBase64"), Encoded);
+	return MCPResult(Result);
+}
