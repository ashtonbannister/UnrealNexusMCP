+FString UUAPAgentSubsystem::GetNexusPIEPhaseV1() const
+{
+    if (!GEditor) { return TEXT("Unknown"); }
+    // The native queued request precedes PostPIEStarted. Never report idle in that gap.
+    if (GEditor->IsPlaySessionRequestQueued()) { return TEXT("Starting"); }
+    const bool bActive = GEditor->IsPlayingSessionInEditor() || GEditor->PlayWorld != nullptr
+        || GEditor->bIsSimulatingInEditor;
+    if ((CurrentPhase == EAgentPIEPhase::NotPlaying && bActive)
+        || ((CurrentPhase == EAgentPIEPhase::Playing || CurrentPhase == EAgentPIEPhase::Paused) && !bActive))
+    {
+        return TEXT("Unknown");
+    }
+    const UEnum* Enum = StaticEnum<EAgentPIEPhase>();
+    return Enum ? Enum->GetNameStringByValue(static_cast<int64>(CurrentPhase)) : TEXT("Unknown");
+}
+
 double UUAPAgentSubsystem::GetPIEElapsedSeconds() const
 {
     if (PIEStartTimeSeconds <= 0.0) { return 0.0; }
