+static bool NexusIsDirtyEmptyExternal(UPackage* Package)
+{
+	if (!Package || !Package->IsDirty()) return false;
+	const FString Name = Package->GetName();
+	return (Name.Contains(TEXT("/__ExternalActors__/")) || Name.Contains(TEXT("/__ExternalObjects__/")))
+		&& UPackage::IsEmptyPackage(Package);
+}
