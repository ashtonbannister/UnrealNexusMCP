+FString UUAPAgentSubsystem::GetNexusPIEPhaseV1() const
+{
+    if (!GEditor) { return TEXT("Unknown"); }
+    // The native queued request precedes PostPIEStarted. Never report idle in that gap.
+    if (GEditor->IsPlaySessionRequestQueued()) { return TEXT("Starting"); }
+    const bool bActive = GEditor->IsPlayingSessionInEditor() || GEditor->PlayWorld != nullptr
+        || GEditor->bIsSimulatingInEditor;
+    if ((CurrentPhase == EAgentPIEPhase::NotPlaying && bActive)
+        || ((CurrentPhase == EAgentPIEPhase::Playing || CurrentPhase == EAgentPIEPhase::Paused) && !bActive))
+    {
+        return TEXT("Unknown");
+    }
+    const UEnum* Enum = StaticEnum<EAgentPIEPhase>();
+    return Enum ? Enum->GetNameStringByValue(static_cast<int64>(CurrentPhase)) : TEXT("Unknown");
+}
+
+FString UUAPAgentSubsystem::NexusOwnedPIEReceipt(bool bOk, const FString& State) const
+{
+    TSharedRef<FJsonObject> O = MakeShared<FJsonObject>();
+    O->SetBoolField(TEXT("ok"), bOk);
+    O->SetStringField(TEXT("state"), State);
+    O->SetStringField(TEXT("editorEpoch"), NexusEditorEpoch);
+    if (!NexusSessionId.IsEmpty()) O->SetStringField(TEXT("sessionId"), NexusSessionId);
+    FString Out;
+    TSharedRef<TJsonWriter<>> W = TJsonWriterFactory<>::Create(&Out);
+    FJsonSerializer::Serialize(O, W);
+    return Out;
+}
+
+FString UUAPAgentSubsystem::NexusOwnedPIEState() const
+{
+    if (!GEditor || !NexusOwnedPlaySettings || NexusOwnerToken.IsEmpty()) return TEXT("unknown");
+    const auto Queued = GEditor->GetPlaySessionRequest();
+    const auto Active = GEditor->GetPlayInEditorSessionInfo();
+    const bool bOurQueue = Queued.IsSet() && Queued->EditorPlaySettings == NexusOwnedPlaySettings;
+    const bool bOurActive = Active.IsSet() && Active->OriginalRequestParams.EditorPlaySettings == NexusOwnedPlaySettings;
+    // Any competing request or session invalidates ownership, even while ours still exists.
+    if ((Queued.IsSet() && !bOurQueue) || (Active.IsSet() && !bOurActive)) return TEXT("conflict");
+    if (bOurQueue) return TEXT("starting");
+    if (bOurActive)
+    {
+        if (CurrentPhase == EAgentPIEPhase::Ending) return TEXT("ending");
+        if (GEditor->PlayWorld && (CurrentPhase == EAgentPIEPhase::Playing || CurrentPhase == EAgentPIEPhase::Paused))
+            return TEXT("playing");
+        return TEXT("starting");
+    }
+    if (bNexusEndObserved && !GEditor->PlayWorld && !GEditor->bIsSimulatingInEditor)
+        return TEXT("ended");
+    return TEXT("unknown");
+}
+
+FString UUAPAgentSubsystem::NexusBeginOwnedPIE(const FString& OwnerToken)
+{
+    if (!IsInGameThread() || !GEditor || OwnerToken.Len() != 64 || NexusEditorEpoch.IsEmpty())
+        return NexusOwnedPIEReceipt(false, TEXT("invalid"));
+    for (TCHAR C : OwnerToken) if (!FChar::IsHexDigit(C)) return NexusOwnedPIEReceipt(false, TEXT("invalid"));
+    if (!NexusOwnerToken.IsEmpty()) return NexusOwnedPIEReceipt(false, TEXT("owner_exists"));
+    if (GEditor->IsPlaySessionInProgress() || GEditor->PlayWorld || GEditor->bIsSimulatingInEditor)
+        return NexusOwnedPIEReceipt(false, TEXT("busy"));
+
+    FLevelEditorModule& LevelEditor = FModuleManager::LoadModuleChecked<FLevelEditorModule>(TEXT("LevelEditor"));
+    TSharedPtr<IAssetViewport> Viewport = LevelEditor.GetFirstActiveViewport();
+    if (!Viewport.IsValid()) return NexusOwnedPIEReceipt(false, TEXT("no_viewport"));
+
+    // Unreal saves dirty maps/content when these settings require another process.
+    // Keep the existing configuration, but refuse before requesting PIE.
+    const ULevelEditorPlaySettings* Settings = GetDefault<ULevelEditorPlaySettings>();
+    if (!Settings) return NexusOwnedPIEReceipt(false, TEXT("settings_unavailable"));
+    bool bOneProcess = false;
+    int32 NumClients = 0;
+    EPlayNetMode NetMode = EPlayNetMode::PIE_Standalone;
+    Settings->GetRunUnderOneProcess(bOneProcess);
+    Settings->GetPlayNumberOfClients(NumClients);
+    Settings->GetPlayNetMode(NetMode);
+    if (!bOneProcess && (NumClients > 1 || NetMode == EPlayNetMode::PIE_Client))
+        return NexusOwnedPIEReceipt(false, TEXT("external_process_requires_save"));
+
+    FRequestPlaySessionParams Params;
+    Params.SessionDestination = EPlaySessionDestinationType::InProcess;
+    Params.WorldType = EPlaySessionWorldType::PlayInEditor;
+    Params.DestinationSlateViewport = Viewport;
+    GEditor->RequestPlaySession(Params);
+    const auto Queued = GEditor->GetPlaySessionRequest();
+    if (!Queued.IsSet() || !Queued->EditorPlaySettings)
+        return NexusOwnedPIEReceipt(false, TEXT("outcome_unknown"));
+
+    NexusOwnedPlaySettings = Queued->EditorPlaySettings;
+    NexusOwnerToken = OwnerToken;
+    NexusSessionId = FGuid::NewGuid().ToString(EGuidFormats::Digits);
+    bNexusEndObserved = false;
+    return NexusOwnedPIEReceipt(true, TEXT("starting"));
+}
+
+FString UUAPAgentSubsystem::NexusOwnedPIEStatus(const FString& OwnerToken) const
+{
+    if (!IsInGameThread() || NexusOwnerToken.IsEmpty() || OwnerToken != NexusOwnerToken)
+        return NexusOwnedPIEReceipt(false, TEXT("not_owner"));
+    const FString State = NexusOwnedPIEState();
+    return NexusOwnedPIEReceipt(State != TEXT("conflict") && State != TEXT("unknown"), State);
+}
+
+FString UUAPAgentSubsystem::NexusStopOwnedPIE(const FString& OwnerToken)
+{
+    if (!IsInGameThread() || NexusOwnerToken.IsEmpty() || OwnerToken != NexusOwnerToken)
+        return NexusOwnedPIEReceipt(false, TEXT("not_owner"));
+    const FString State = NexusOwnedPIEState();
+    if (State == TEXT("ended")) return NexusOwnedPIEReceipt(true, State);
+    if (State == TEXT("conflict") || State == TEXT("unknown")) return NexusOwnedPIEReceipt(false, State);
+    const auto Queued = GEditor->GetPlaySessionRequest();
+    const auto Active = GEditor->GetPlayInEditorSessionInfo();
+    if (Queued.IsSet())
+    {
+        // CancelRequestPlaySession also clears active session info.
+        if (Active.IsSet() || GEditor->PlayWorld) return NexusOwnedPIEReceipt(false, TEXT("transition"));
+        GEditor->CancelRequestPlaySession();
+        const FString After = NexusOwnedPIEState();
+        return NexusOwnedPIEReceipt(After == TEXT("ended"), After);
+    }
+    if (!Active.IsSet() || !GEditor->PlayWorld) return NexusOwnedPIEReceipt(false, TEXT("transition"));
+    GEditor->RequestEndPlayMap();
+    return NexusOwnedPIEReceipt(true, TEXT("ending"));
+}
+
+FString UUAPAgentSubsystem::NexusReleaseEndedPIE(const FString& OwnerToken)
+{
+    if (!IsInGameThread() || NexusOwnerToken.IsEmpty() || OwnerToken != NexusOwnerToken)
+        return NexusOwnedPIEReceipt(false, TEXT("not_owner"));
+    if (NexusOwnedPIEState() != TEXT("ended")) return NexusOwnedPIEReceipt(false, TEXT("not_ended"));
+    const FString Receipt = NexusOwnedPIEReceipt(true, TEXT("released"));
+    NexusOwnerToken.Reset();
+    NexusSessionId.Reset();
+    NexusOwnedPlaySettings = nullptr;
+    bNexusEndObserved = false;
+    return Receipt;
+}
