+def take_nexus_owned() -> tuple[dict | None, dict[str, Any] | None]:
+    """Acquire a new unique sticky grant; never pass through a same-project holder."""
+    if not _coord.machine_lock_enabled():
+        return None, error_response(ErrorCode.MACHINE_BUSY, "Nexus owned PIE requires the machine lock.", recoverable=True)
+    project_file = os.environ.get("NEXUS_UAP_PROJECT_FILE", "")
+    project = os.path.splitext(os.path.basename(project_file.replace("\\", "/")))[0]
+    if not project:
+        return None, error_response(ErrorCode.MACHINE_BUSY, "Nexus project binding is missing.", recoverable=False)
+    agent = "nexus-pie-" + secrets.token_hex(16)
+    try:
+        # An uncertain owner must not be reclaimed automatically after a short
+        # heartbeat timeout. Recovery is an explicit operator action.
+        grant = _coord.acquire_machine(project, reason="nexus-pie", agent=agent, pid=0, wait=0,
+                                       ttl=(1 << 53) - 1, task=_coord.default_task(), require_new=True)
+    except Exception:
+        return None, error_response(ErrorCode.MACHINE_BUSY, "Machine grant could not be acquired.", recoverable=False)
+    if not isinstance(grant, dict) or grant.get("acquired") is not True or grant.get("agent") != agent:
+        return None, error_response(ErrorCode.MACHINE_BUSY, "Machine is already held or could not be verified.", recoverable=True)
+    return {"agent": agent, "project": project}, None
+
+
+def verify_nexus_owned(grant: dict) -> bool:
+    """Confirm the exact unique grant is still held; never acquire or replace it."""
+    if not isinstance(grant, dict) or not isinstance(grant.get("agent"), str) or not grant["agent"].startswith("nexus-pie-"):
+        return False
+    project = grant.get("project")
+    if not isinstance(project, str) or not project:
+        return False
+    try:
+        return _coord.heartbeat_machine(project, agent=grant["agent"]) is True
+    except Exception:
+        return False
+
+
+def release_nexus_owned(grant: dict) -> bool:
+    """Release only the exact unique agent/project grant; never project-wide."""
+    if not isinstance(grant, dict) or not isinstance(grant.get("agent"), str) or not grant["agent"].startswith("nexus-pie-"):
+        return False
+    project = grant.get("project")
+    if not isinstance(project, str) or not project:
+        return False
+    try:
+        result = _coord.release_machine(agent=grant["agent"], project=project, project_wide=False)
+    except Exception:
+        return False
+    if not isinstance(result, dict):
+        return False
+    holder = result.get("was_held_by")
+    return bool(result.get("released") is True and isinstance(holder, dict) and holder.get("agent") == grant["agent"])
