          "actorPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Full PIE actor object path.",
            "pattern": "^/[A-Za-z0-9_][^\\u0000-\\u001F]*$"
          },
          "pieInstance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "Exact PIE world instance."
          },
          "includeProperties": {
            "type": "boolean",
            "description": "Include reflected properties."
          },
          "propertyName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Optional single property to read."
          }
        },
        "required": [
