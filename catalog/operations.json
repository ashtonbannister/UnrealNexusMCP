{
  "version": 1,
  "reviewedOn": "2026-10-26",
  "coverage": "Bounded source-reviewed selection; live qualification pending.",
  "operations": [
    {
      "id": "pie.start.viewport",
      "description": "Start PIE in the viewport and wait for a live phase; no map changes or separate-window claim.",
      "provider": "unrealagentplayer",
      "decision": "pie-lifecycle",
      "effect": "lifecycle",
      "contract": "pie.start.viewport",
      "parameters": {
        "type": "object",
        "properties": {
          "timeout": {
            "type": "number",
            "minimum": 1,
            "maximum": 90,
            "description": "Native start deadline in seconds; default 60."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "route": {
        "kind": "direct",
        "tool": "pie_start",
        "fixed": {
          "mode": "PlayInViewport",
          "wait": true
        }
      },
      "postconditions": [
        "Require parsed ok=true and playing=true; keep phase and warnings.",
        "On queued timeout use explicit stop/reconciliation; never assume editor idle.",
        "Only stop a session owned by this workflow. Remote Control responses still require live qualification."
      ],
      "example": {
        "timeout": 60
      },
      "requiredCompatibility": "uap-nexus-no-replay-v1"
    },
    {
      "id": "pie.stop",
      "description": "Cancel a queued PIE start and wait for confirmed teardown through the same lifecycle provider.",
      "provider": "unrealagentplayer",
      "decision": "pie-lifecycle",
      "effect": "lifecycle",
      "contract": "pie.stop",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "route": {
        "kind": "direct",
        "tool": "pie_stop",
        "fixed": {}
      },
      "postconditions": [
        "Require parsed ok=true, stopped=true and phase=NotPlaying.",
        "The upstream schema has no timeout argument; preserve machine-hold semantics."
      ],
      "example": {},
      "requiredCompatibility": "uap-nexus-no-replay-v1"
    },
    {
