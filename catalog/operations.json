      "route": {
        "kind": "ue-micro",
        "category": "level",
        "method": "get_actor_details",
        "fixed": {
          "world": "pie"
        }
      },
      "postconditions": [
        "Verify returned identity and PIE instance; never substitute the editor-world actor."
      ],
      "example": {
        "actorPath": "/Game/Maps/UEDPIE_1_Demo.Demo:PersistentLevel.Cube",
        "pieInstance": 1
      }
    },
    {
      "id": "level.save.current",
      "description": "Save the currently edited level and its loaded external packages without the broad commitDeletes sweep.",
      "provider": "ue-mcp",
      "decision": "level-save",
      "effect": "write",
      "contract": "level.save.current",
      "parameters": {
        "type": "object",
        "properties": {
          "force": {
            "type": "boolean",
            "description": "Explicitly write even clean packages; default false."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "route": {
        "kind": "ue-micro",
        "category": "level",
        "method": "save",
        "fixed": {
          "commitDeletes": false,
          "includeExternalActors": true
        }
      },
      "postconditions": [
        "Confirm the intended level is current before dispatch; this call does not take a level path.",
        "Inspect saved, failed, skipped and deleted package receipts; any failed package is not full success.",
        "PIE must be stopped. Do not broaden to save-all to work around a refusal."
      ],
      "example": {}
    },
    {
      "id": "asset.save.exact",
      "description": "Save only a nonempty explicit list of loaded asset/object/package paths.",
      "provider": "ue-mcp",
      "decision": "asset-save",
      "effect": "write",
      "contract": "asset.save.exact",
      "parameters": {
        "type": "object",
        "properties": {
          "assetPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Exact loaded asset/object/package path.",
              "pattern": "^/[A-Za-z0-9_][^\\u0000-\\u001F]*$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "force": {
            "type": "boolean",
            "description": "Write even when dirty flag is absent; explicit choice, default false."
          }
        },
        "required": [
          "assetPaths"
        ],
        "additionalProperties": false
      },
      "route": {
        "kind": "ue-micro",
        "category": "asset",
        "method": "save",
        "fixed": {}
      },
      "postconditions": [
        "Verify every requested package result and on-disk path/size/mtime.",
        "Missing/unresolvable targets must refuse before writing; failed per-package save is not success.",
        "No assetPath=all, omitted selector, directory save or save-all route is exposed."
      ],
      "example": {
        "assetPaths": [
          "/Game/Blueprints/BP_Demo"
        ],
        "force": true
      }
    },
    {
      "id": "pcg.graph.connect.persisted",
      "description": "Connect explicitly named PCG nodes/pins, verify the edge and check persistence.",
      "provider": "ue-mcp",
      "decision": "pcg-connection",
      "effect": "write",
      "contract": "pcg.graph.connect.persisted",
      "parameters": {
        "type": "object",
        "properties": {
          "assetPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "PCGGraph asset path.",
            "pattern": "^/[A-Za-z0-9_][^\\u0000-\\u001F]*$"
          },
          "sourceNode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Stable source node identifier from a fresh graph read."
          },
          "sourcePin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Explicit output pin label."
          },
          "targetNode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Stable target node identifier from a fresh graph read."
          },
          "targetPin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Explicit input pin label."
          }
        },
        "required": [
          "assetPath",
          "sourceNode",
          "sourcePin",
          "targetNode",
          "targetPin"
        ],
        "additionalProperties": false
      },
      "route": {
        "kind": "ue-micro",
        "category": "pcg",
        "method": "connect_nodes",
        "fixed": {}
      },
      "postconditions": [
        "Check actual edge and save result; do not translate stale numeric node indices.",
        "An already-existing edge is not a newly created change and must not get a destructive inverse."
      ],
      "example": {
        "assetPath": "/Game/PCG/PCG_Demo",
        "sourceNode": "InputNode",
        "sourcePin": "In",
        "targetNode": "OutputNode",
        "targetPin": "Out"
      }
    },
    {
      "id": "pcg.generation.execute",
      "description": "Trigger the first PCG component on an exact actor; return the real component and run ID, not a completion claim.",
      "provider": "ue-mcp",
      "decision": "pcg-generation",
      "effect": "write",
      "contract": "pcg.generation.execute",
      "parameters": {
        "type": "object",
        "properties": {
          "actorPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Exact editor actor path.",
