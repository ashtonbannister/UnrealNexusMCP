    {
      "id": "screenshot.viewport.current",
      "description": "Capture the currently visible viewport as an MCP image. During PIE this can be a game/ejected view, not editor-world-only.",
      "provider": "enginewire",
      "decision": "editor-screenshot",
      "effect": "read",
      "contract": "screenshot.viewport.current",
      "parameters": {
        "type": "object",
        "properties": {
          "resolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 9,
            "description": "Downscale bounding box, not a rerender resolution.",
            "pattern": "^[1-9][0-9]{0,3}x[1-9][0-9]{0,3}$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "route": {
        "kind": "enginewire",
        "tool": "control_editor",
        "action": "screenshot",
        "fixed": {
          "mode": "editor_viewport",
          "returnBase64": true,
          "keepFile": false,
          "waitForShaders": true
        }
      },
      "postconditions": [
        "Require an MCP image block before claiming visual inspection; preserve actual dimensions, view and shaderWait receipt.",
        "mode=editor_viewport can select a possessed PIE viewport or an ejected view. Inspect the returned view; require separately reconciled NotPlaying for editor-world-only intent.",
        "Resolution is downscaling, not rerendering. Shader waiting can expire with outstanding compilation.",
        "This is not exact PIE-client selection, guaranteed UMG capture or full-window capture."
      ],
      "example": {
        "resolution": "1280x720"
      }
    },
    {
      "id": "screenshot.pie",
      "description": "Capture a selected PIE viewport including UMG to a fresh PNG filename; result may be a host file path, not an inline image.",
      "provider": "ue-mcp",
      "decision": "pie-screenshot",
      "effect": "write",
      "contract": "screenshot.pie",
      "parameters": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 124,
            "description": "Use a fresh unique basename; upstream can overwrite an existing file.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\.png$"
          },
          "pieInstance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "Exact PIE world instance."
          },
          "worldPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Optional additional exact PIE world path.",
            "pattern": "^/[A-Za-z0-9_][^\\u0000-\\u001F]*$"
          }
        },
        "required": [
          "filename",
          "pieInstance"
        ],
        "additionalProperties": false
      },
      "route": {
        "kind": "ue-micro",
        "category": "editor",
        "method": "capture_screenshot",
        "fixed": {
          "target": "pie"
        }
      },
      "postconditions": [
        "Check reported world/instance, actual dimensions and successful file write.",
        "The filename restriction is a Nexus policy, not an atomic no-overwrite guarantee.",
        "A returned path is not evidence that the assistant received or viewed the image."
      ],
      "example": {
        "filename": "nexus-frame-unique-0001.png",
        "pieInstance": 1
      }
    },
