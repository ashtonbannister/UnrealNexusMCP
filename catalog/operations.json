      "example": {
        "actorPath": "/Game/Maps/Demo.Demo:PersistentLevel.PCGActor"
      }
    },
    {
      "id": "pcg.generation.wait",
      "description": "Wait for a particular actor/component/run and require generated, not merely a terminal or idle state.",
      "provider": "ue-mcp",
      "decision": "pcg-generation",
      "effect": "read",
      "contract": "pcg.generation.wait",
      "parameters": {
        "type": "object",
        "properties": {
          "actorPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Actor path returned by execute.",
            "pattern": "^/[A-Za-z0-9_][^\\u0000-\\u001F]*$"
          },
          "componentName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Component name returned by execute."
          },
          "runId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "Run ID returned by execute."
          },
          "timeoutSeconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 90,
            "description": "Polling deadline; keep below the transport deadline."
          }
        },
        "required": [
          "actorPath",
          "componentName",
          "runId",
          "timeoutSeconds"
        ],
        "additionalProperties": false
      },
      "route": {
        "kind": "ue-micro",
        "category": "pcg",
        "method": "wait_for_generation",
        "fixed": {}
      },
      "postconditions": [
        "Require state=generated. cancelled, cleaned, not_started, idle and timed_out are not generation success.",
        "Preserve lastRun and warning fields; do not retry execute on a wait timeout."
      ],
      "example": {
        "actorPath": "/Game/Maps/Demo.Demo:PersistentLevel.PCGActor",
        "componentName": "PCGComponent",
        "runId": 1,
        "timeoutSeconds": 60
      }
    },
    {
      "id": "input.action.once",
      "description": "Inject one Enhanced Input action into an explicit local PIE player, not Slate/UI key dispatch.",
      "provider": "ue-mcp",
      "decision": "enhanced-input",
      "effect": "write",
      "contract": "input.action.once",
      "parameters": {
        "type": "object",
        "properties": {
          "action_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "InputAction asset path.",
            "pattern": "^/[A-Za-z0-9_][^\\u0000-\\u001F]*$"
          },
          "value_x": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38,
            "description": "Finite X/bool value."
          },
          "value_y": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38,
            "description": "Finite Y value."
          },
          "value_z": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38,
            "description": "Finite Z value."
          },
          "client_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Local player inside the selected PIE world."
          },
          "pie_instance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "Exact PIE world instance."
          }
        },
        "required": [
          "action_path",
          "client_id",
          "pie_instance"
        ],
        "additionalProperties": false
      },
      "route": {
        "kind": "ue-micro",
        "category": "pie",
        "method": "inject_input",
        "fixed": {}
      },
      "postconditions": [
        "Confirm the intended action/world/player and observe resulting gameplay.",
        "Remote client relay is not exposed; UI/key dispatch is a different operation."
      ],
      "example": {
        "action_path": "/Game/Input/IA_Move.IA_Move",
        "value_x": 1,
        "client_id": 0,
        "pie_instance": 1
      }
    },
