{
  "name": "unreal-nexus-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Unified Unreal MCP exposing complete namespaced provider interfaces and compatible canonical workflows through one entrypoint.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "build": "node scripts/build.mjs",
    "test:integration": "node --test test/unified-providers.test.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/validate-catalog.mjs && npm test",
    "catalog": "node src/cli.mjs",
    "catalog:check": "node scripts/validate-catalog.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0"
  }
}
